@page "/"
@inject IAuthenticationService AuthenticationManager

<PageTitle>Home | Systek</PageTitle>

<div class="dashboard">

    <section class="hero">

        <div>
            <span class="hero-label">
                SYSTEK BİLİŞİM
            </span>

            <h1>
                Customer Support Platform
            </h1>

            <p>
                Manage your knowledge base and interact with the
                AI-powered customer support system.
            </p>

            <div class="hero-actions">

                <a href="/chat" class="primary-button">
                    Start a Conversation
                </a>

               

            </div>
        </div>

    </section>


    <section class="section">

        <div class="section-header">

            <div>
                <h2>Platform</h2>
                <p>Access the main capabilities of the platform.</p>
            </div>

        </div>


        <div class="feature-grid">

            <a href="/chat" class="feature-card">

                <div class="feature-icon">
                    💬
                </div>

                <div>
                    <h3>Customer Support Chat</h3>

                    <p>
                        Ask questions and receive answers from
                        the company's knowledge base.
                    </p>
                </div>

                <span class="feature-arrow">
                    →
                </span>

            </a>

            @if (IsAuthenticated && IsAdmin)
            {
                
                <a href="/knowledges" class="feature-card">

                    <div class="feature-icon">
                        ▤
                    </div>

                    <div>
                        <h3>Knowledge Base</h3>

                        <p>
                            Browse and manage the documents used
                            by the support system.
                        </p>
                    </div>

                    <span class="feature-arrow">
                        →
                    </span>

                </a>
            }


            <a href="/knowledges/upload" class="feature-card">

                <div class="feature-icon">
                    ↑
                </div>

                <div>
                    <h3>Document Management</h3>

                    <p>
                        Upload new knowledge documents to improve
                        customer support responses.
                    </p>
                </div>

                <span class="feature-arrow">
                    →
                </span>

            </a>

        </div>

    </section>

</div>


@code{
    private bool IsAuthenticated => AuthenticationManager.IsAuthenticated;

    private bool IsAdmin =>
        AuthenticationManager.CurrentUser?.Roles?.Contains("Admin") == true;
}