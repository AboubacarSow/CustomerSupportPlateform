@inherits LayoutComponentBase
@inject IAuthenticationService  AuthenticationService
@inject NavigationManager Navigation
<div class="main-layout">

    <header class="main-header">

        <div class="brand">
            <a href="/">
                <div class="brand-logo">
                    S
                </div>

                <div class="brand-text">
                    <strong>SysTek Bilişim</strong>
                    <span>Customer Support Platform</span>
                </div>
            </a>
        </div>

        <nav class="main-navigation">

            <NavLink href="/" Match="NavLinkMatch.All">
                Home
            </NavLink>

            <NavLink href="/chat">
                Chat
            </NavLink>

            @if(IsAuthenticated && IsAdmin)
            {
                <NavLink href="/knowledges">
                    Knowledge Base
                </NavLink>
            }

            

        </nav>

        <div class="header-actions">
            @if (!IsAuthenticated)
            {
                <a href="/auth/login" class="login-link">
                    Login
                </a>  

                <a href="/auth/register" class="register-button">
                    Register
                </a>
            }
            else
            {
                <NavLink class="nav-link" href="/lougout-callback">
                    Logout
                </NavLink>
                
            }

        </div>

    </header>


    <main class="main-content">

        @Body

    </main>


    <footer class="main-footer">

        <span>
            © @DateTime.Now.Year Systek Bilişim
        </span>

        <span>
            Customer Support Platform
        </span>

    </footer>
    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>

</div>


@code {

    private bool IsAuthenticated => AuthenticationService.IsAuthenticated;

    private bool IsAdmin =>
        AuthenticationService.CurrentUser?.Roles?.Contains("Admin") == true;

    private string? UserEmail =>
        AuthenticationService.CurrentUser?.Email;

    private string UserRole =>
        IsAdmin ? "Administrator" : "User";

    private string GetInitials()
    {
        if (string.IsNullOrWhiteSpace(UserEmail))
            return "U";

        return UserEmail[..1].ToUpper();
    }

    private async Task LogoutAsync()
    {
        await AuthenticationService.LogoutAsync();

        Navigation.NavigateTo("/auth/login", forceLoad: true);
    }
}

