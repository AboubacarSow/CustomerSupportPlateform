<div class="chat-widget">

    <div class="chat-messages">
        @if (Messages.Count == 0)
        {
            <div class="chat-empty">
                <div class="chat-empty-icon">
                    ?
                </div>

                <h3>How can we help?</h3>

                <p>
                    Ask a question about Systek Bilişim's services.
                </p>
            </div>
        }
        else
        {
            @foreach (var message in Messages)
            {
                <ChatMessage Message="message" />
            }
        }

        @if (IsLoading)
        {
            <div class="message-row assistant">
                <div class="message-bubble loading">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        }

        <div @ref="_messagesEnd"></div>
    </div>

    <div class="chat-input-container">
        <form onsubmit="SendMessageAsync">
            <div class="chat-input-wrapper">

                <InputText
                    @bind-Value="Question"
                    class="chat-input"
                    placeholder="Ask a question..."
                    disabled="@IsLoading" />

                <button
                    type="submit"
                    class="chat-send-button"
                    disabled="@IsLoading || string.IsNullOrWhiteSpace(Question)">

                    @if (IsLoading)
                    {
                        <span>...</span>
                    }
                    else
                    {
                        <span>Send</span>
                    }

                </button>

            </div>
        </form>

        <div class="chat-disclaimer">
            Systek Customer Support Assistant
        </div>
    </div>

</div>

@code {

    [Parameter]
    public List<ChatMessageModel> Messages { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<string> OnSendMessage { get; set; }

    private string Question { get; set; } = string.Empty;

    private ElementReference _messagesEnd;

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(Question) || IsLoading)
            return;

        var question = Question.Trim();

        Question = string.Empty;

        await OnSendMessage.InvokeAsync(question);
    }
}
